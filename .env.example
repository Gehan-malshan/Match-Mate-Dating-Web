# Local optional integrations. Copy selected values to a root .env file before
# running `docker compose up --build -d`. Never commit the real .env file.

# Google Cloud OAuth 2.0 web application credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/login?google=success

# Set NOTIFICATION_PROVIDER=smtp only after SMTP credentials are configured.
NOTIFICATION_PROVIDER=dev-sink
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Replace with a long random secret before staging/production. This is shared
# only by Account and the Notification worker.
INTERNAL_SERVICE_TOKEN=matchmate-local-notification-only
