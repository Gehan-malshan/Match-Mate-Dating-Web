PAYMENT_HTTP_ADDRESS=:8084
PAYMENT_DATABASE_URL=postgres://matchmate_payment:local-only@127.0.0.1:5436/matchmate_payment?sslmode=disable
PAYMENT_BOOKING_SNAPSHOT_URL=http://127.0.0.1:8085/internal/v1/bookings/{bookingId}/payment-snapshot
PAYMENT_JWT_PUBLIC_KEY_PEM=replace-with-account-es256-public-key
ACCOUNT_JWKS_URL=http://127.0.0.1:8081/.well-known/jwks.json
JWT_ISSUER=matchmate-account
JWT_AUDIENCE=matchmate-api
PAYHERE_ENVIRONMENT=sandbox
PAYHERE_MERCHANT_ID=replace-with-sandbox-merchant-id
PAYHERE_MERCHANT_SECRET=replace-in-local-ignored-env
PAYHERE_RETURN_URL=http://localhost:5173/app/bookings
PAYHERE_CANCEL_URL=http://localhost:5173/app/bookings
PAYHERE_NOTIFY_URL=https://public-development-host.example/api/v1/payments/payhere/callback
PAYMENT_RABBITMQ_URL=amqp://matchmate:matchmate@127.0.0.1:5672/
PAYMENT_EVENT_EXCHANGE=matchmate.events
