APP_ENV=development
HTTP_ADDRESS=:8081
DATABASE_URL=postgres://matchmate:matchmate@localhost:5433/matchmate_account?sslmode=disable
RABBITMQ_URL=amqp://matchmate:matchmate@localhost:5672/
EVENT_EXCHANGE=matchmate.events
JWT_ISSUER=matchmate-account
JWT_AUDIENCE=matchmate-api
JWT_KEY_ID=account-dev-1
# Required in production: PKCS#8 P-256 private key PEM with newlines escaped for the runtime.
JWT_PRIVATE_KEY_PEM=
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=720h
VERIFICATION_TOKEN_TTL=24h
MINIMUM_AGE=18
CURRENT_CONSENT_VERSION=privacy-2026-08
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Development only: include the email-verification token in registration responses.
DEV_EXPOSE_VERIFICATION_TOKEN=true
# Optional Google OAuth login. Configure all three values together. The redirect
# URI must exactly match the Google Cloud Console configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/login?google=success
# Required in production. Shared only with the Notification delivery worker for
# narrowly scoped, runtime-only recipient email resolution.
INTERNAL_SERVICE_TOKEN=
