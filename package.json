{
  "name": "matchmate",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend/apps/*",
    "frontend/packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend/apps/web dev",
    "dev:web": "bun run --cwd frontend/apps/web dev",
    "build:web": "bun run --cwd frontend/apps/web build",
    "typecheck:web": "bun run --cwd frontend/apps/web typecheck",
    "test:web": "bun run --cwd frontend/apps/web test",
    "graphql:generate": "cd services/graphql-gateway && go tool gqlgen generate"
  }
}
