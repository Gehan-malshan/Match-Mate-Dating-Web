{
  "name": "matchmate",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend/apps/*",
    "frontend/packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd frontend/apps/web dev",
    "build:web": "bun run --cwd frontend/apps/web build",
    "typecheck:web": "bun run --cwd frontend/apps/web typecheck",
    "test:web": "bun run --cwd frontend/apps/web test",
    "dev:admin": "bun run --cwd frontend/apps/admin dev",
    "build:admin": "bun run --cwd frontend/apps/admin build",
    "typecheck:admin": "bun run --cwd frontend/apps/admin typecheck",
    "test:admin": "bun run --cwd frontend/apps/admin test"
  }
}
